{
  "name": "swiftconvertor",
  "version": "0.1.0",
  "description": "Small app to convert simple payment input into SWIFT PACS XML",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "validator:build": "docker build -t swiftconvertor-validator tools/validator",
    "validator:run": "node tools/validator/runValidator.js",
    "validator-api:build": "docker build -t swiftconvertor-validator-api tools/validator/api",
    "validator-api:run": "docker run --rm -p 3001:3001 -v ${PWD}/app/xsds:/xsds swiftconvertor-validator-api"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "license": "MIT"
}
